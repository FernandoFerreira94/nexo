# Provedor do LLM: mock (sem chave, respostas roteirizadas) | openrouter
LLM_PROVIDER=mock
LLM_API_KEY=
# Modelo no formato do OpenRouter (ex.: um modelo barato para testes, um melhor na entrega)
LLM_MODEL=anthropic/claude-haiku-5.5

# Camada de decisão: llm (padrão) | jev (opcional, TypeSafe via OpenRouter)
DECISION_PROVIDER=llm

# Serviço de chamados (legado simulado)
TICKETS_SERVICE_URL=http://localhost:4010
TICKETS_SERVICE_PORT=4010
TICKETS_SERVICE_TOKEN=troque-este-token-local
# Probabilidade (0 a 1) de cada requisição falhar com 503
TICKETS_FAILURE_RATE=0.1

# Regras
CONFIDENCE_THRESHOLD=0.6
SESSION_MESSAGE_LIMIT=30
SESSION_MESSAGE_WARN_AT=25

# Assinatura do cookie de sessão (gere um valor longo e aleatório)
AUTH_SECRET=troque-por-um-segredo-longo
