# Provedor do LLM: mock (sem chave, respostas roteirizadas) | openrouter
LLM_PROVIDER=mock
LLM_API_KEY=
# Modelo no formato do OpenRouter. Padrão: Claude Haiku 5.5 (ver DECISOES, "Modelo final").
# Ao trocar de modelo, ajuste também os preços abaixo (US$ por 1M tokens), usados no custo do trace.
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50

# Camada de decisão: llm (padrão) | jev (opcional, TypeSafe via OpenRouter)
DECISION_PROVIDER=llm

# Serviço de chamados (legado simulado)
# Local: servidor próprio na porta abaixo. Na Vercel: "embedded" (roda dentro do app, mesmo contrato HTTP).
TICKETS_SERVICE_URL=http://localhost:4010
TICKETS_SERVICE_PORT=4010
TICKETS_SERVICE_TOKEN=troque-este-token-local
# Probabilidade (0 a 1) de cada requisição falhar com 503
TICKETS_FAILURE_RATE=0.1

# Regras
CONFIDENCE_THRESHOLD=0.6
SESSION_MESSAGE_LIMIT=30
SESSION_MESSAGE_WARN_AT=25

# Assinatura do cookie de sessão (gere um valor longo e aleatório)
AUTH_SECRET=troque-por-um-segredo-longo

# Banco. Local: arquivos SQLite em data/ (nada a configurar).
# Na Vercel: a integração do Turso cria estas duas variáveis sozinha.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=
