{
  "name": "@nexo/tickets-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:setup": "tsx --env-file-if-exists=../../.env src/db/setup.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/setup.ts --reset",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@nexo/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15"
  }
}
